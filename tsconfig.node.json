{
  "compilerOptions": {
    /* Incremental builds — cache type-check results for faster rebuilds */
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "target": "ES2024",
    /* DOM: e2e `page.evaluate` callbacks run in the browser (getComputedStyle) */
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "oxfmt.config.mts",
    "oxlint.config.mts",
    "playwright.config.ts",
    "e2e/**/*.ts"
  ]
}
