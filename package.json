{
  "name": "bulls-and-cows",
  "version": "0.1.0",
  "private": true,
  "description": "A code-breaking game inspired by Mastermind",
  "license": "0BSD",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.ts",
    "social-preview": "playwright install chromium && node scripts/generate-social-preview.ts",
    "lint": "node scripts/lint-with-timing.js",
    "typecheck": "node scripts/tscheck-with-timing.js",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright install chromium && playwright test",
    "e2e:ui": "playwright install chromium && playwright test --ui",
    "check": "node scripts/pre-push-checks.js",
    "prepare": "husky",
    "licenses:update": "node scripts/third-party-licenses.ts",
    "analyze": "node scripts/bundle-analysis.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "@xstate/react": "^6.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "i18next": "27.1.5",
    "lucide-react": "1.74.0",
    "radix-ui": "1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "18.0.2",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "workbox-window": "^7.4.1",
    "xstate": "^5.33.4",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "code-inspector-plugin": "2.0.9",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "rollup-plugin-visualizer": "^7.1.3",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.7.0"
}
