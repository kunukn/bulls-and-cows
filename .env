# Committed, non-secret defaults shared by everyone. Don't edit this file for
# personal settings.
#
# Want different values? Create a `.env.local` next to this file (gitignored)
# and set only the keys you want to change; Vite loads it after `.env`, so its
# values win. Restart `pnpm dev` after editing. Example `.env.local`:
#
#   VITE_CODE_INSPECTOR=1
#   VITE_RAINBOW_DEBUG=1
#
# Everything prefixed VITE_ ends up in the client bundle: never put secrets here.

# 1 = Code Inspector in dev: Option+Shift (macOS) / Alt+Shift, then click an element to open its source.
VITE_CODE_INSPECTOR=0

# 1 = load the rainbow CSS debugger (public/rainbow.js); toggle outlines with Alt+Shift+R.
# Also available on any build via ?debug_rainbow=1 in the URL.
VITE_RAINBOW_DEBUG=0
